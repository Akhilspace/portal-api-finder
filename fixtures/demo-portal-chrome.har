notonicTime":878.061,"_resourceType":"image","serverIPAddress":"127.0.0.1","_serverPort":4000,"_securityDetails":{}},{"pageref":"page@5d6d32157e8754ce1a27be9fbedcc044","startedDateTime":"2026-11-16T17:45:53.404Z","time":14.116999999999999,"request":{"method":"GET","url":"http://localhost:4000/static/app.js","httpVersion":"HTTP/1.1","cookies":[{"name":"sid","value":"9db87b289c04b966a0184457ced2067c"},{"name":"ui_theme","value":"light"}],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"en-US,en;q=0.9"},{"name":"Connection","value":"keep-alive"},{"name":"Cookie","value":"sid=9db87b289c04b966a0184457ced2067c; ui_theme=light"},{"name":"Host","value":"localhost:4000"},{"name":"Referer","value":"http://localhost:4000/dashboard"},{"name":"Sec-Fetch-Dest","value":"script"},{"name":"Sec-Fetch-Mode","value":"no-cors"},{"name":"Sec-Fetch-Site","value":"same-origin"},{"name":"User-Agent","value":"Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) HeadlessChrome/153.0.0.0 Safari/537.36"},{"name":"sec-ch-ua","value":"\"Chromium\";v=\"153\", \"Not_A Brand\";v=\"8\""},{"name":"sec-ch-ua-mobile","value":"?0"},{"name":"sec-ch-ua-platform","value":"\"Linux\""}],"queryString":[],"headersSize":571,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Connection","value":"keep-alive"},{"name":"Content-Length","value":"2818"},{"name":"Content-Type","value":"application/javascript; charset=utf-8"},{"name":"Date","value":"Mon, 16 Nov 2026 17:45:53 GMT"},{"name":"ETag","value":"W/\"b02-k0ltWLo5uwDpUhR+aZXhQ3B9KV8\""},{"name":"Keep-Alive","value":"timeout=5"},{"name":"X-Powered-By","value":"Express"}],"content":{"size":2818,"mimeType":"application/javascript; charset=utf-8","compression":0,"text":"\nconst csrf = document.querySelector('meta[name=\"csrf-token\"]').content;\nconst $ = (id) => document.getElementById(id);\nconst api = (url, opts = {}) => fetch(url, { ...opts, headers: { \"X-Requested-With\": \"XMLHttpRequest\", ...(opts.headers || {}) } }).then((r) => r.json());\nconst beacon = (event) => fetch(\"/api/telemetry\", { method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify({ event, ts: Date.now(), path: location.pathname }) });\nlet patient = null, slot = null, timer = null;\napi(\"/api/me\").then((me) => ($(\"who\").textContent = me.displayName));\napi(\"/api/providers\").then((d) => { $(\"provider\").innerHTML = d.providers.map((p) => '<option value=\"' + p.id + '\">' + p.name + \"</option>\").join(\"\"); loadSlots(); });\nsetInterval(() => api(\"/api/notifications/unread-count\").then((d) => ($(\"unread\").textContent = d.unread)), 3000);\n$(\"q\").addEventListener(\"input\", () => { clearTimeout(timer); timer = setTimeout(search, 250); });\nasync function search() {\n  const q = $(\"q\").value.trim(); if (q.length < 2) return;\n  const d = await api(\"/api/patients?query=\" + encodeURIComponent(q) + \"&limit=10\");\n  $(\"results\").innerHTML = d.results.map((p) => '<li data-id=\"' + p.id + '\">' + p.lastName + \", \" + p.firstName + \" (\" + p.mrn + \")</li>\").join(\"\") || \"<li>No match</li>\";\n}\n$(\"results\").addEventListener(\"click\", (e) => { const li = e.target.closest(\"li[data-id]\"); if (!li) return; patient = Number(li.dataset.id); $(\"picked\").textContent = li.textContent; $(\"charge\").innerHTML = ' <a href=\"/legacy/billing/new.php?pid=' + patient + '\">Add a billing charge (legacy module)</a>'; beacon(\"patient_selected\"); });\n$(\"provider\").addEventListener(\"change\", loadSlots); $(\"date\").addEventListener(\"change\", loadSlots);\nasync function loadSlots() {\n  const d = await api(\"/api/providers/\" + $(\"provider\").value + \"/slots?date=\" + $(\"date\").value);\n  $(\"slots\").innerHTML = d.slots.map((s) => '<button type=\"button\" data-slot=\"' + s.slotId + '\">' + s.start.slice(11, 16) + \"</button>\").join(\"\");\n}\n$(\"slots\").addEventListener(\"click\", (e) => { if (!e.target.dataset.slot) return; slot = e.target.dataset.slot; [...$(\"slots\").children].forEach((b) => b.classList.toggle(\"on\", b === e.target)); });\n$(\"book\").addEventListener(\"click\", async () => {\n  if (!patient || !slot) return ($(\"msg\").textContent = \"Pick a patient and a time first.\");\n  beacon(\"book_clicked\");\n  const d = await api(\"/api/appointments\", { method: \"POST\", headers: { \"Content-Type\": \"application/json\", \"X-CSRF-Token\": csrf },\n    body: JSON.stringify({ patientId: patient, providerId: Number($(\"provider\").value), slotId: slot, reason: $(\"reason\").value, visitType: \"office\", notifyPatient: true }) });\n  $(\"msg\").textContent = d.appointment ? \"Booked. Confirmation \" + d.appointment.id : \"Error: \" + d.error;\n});\n"},"headersSize":244,"bodySize":2818,"redirectURL":"","_transferSize":3062},"cache":{},"timings":{"dns":-1,"connect":-1,"ssl":-1,"send":0,"wait":3.843,"receive":10.274},"_frameref":"frame@d724e73847c04d50ef9ee2a1ab916fe7","_monotonicTime":878.454,"_resourceType":"script","serverIPAddress":"127.0.0.1","_serverPort":4000,"_securityDetails":{}},{"pageref":"page@5d6d32157e8754ce1a27be9fbedcc044","startedDateTime":"2026-11-16T17:45:53.427Z","time":21.145,"request":{"method":"GET","url":"http://localhost:4000/api/me","httpVersion":"HTTP/1.1","cookies":[{"name":"sid","value":"9db87b289c04b966a0184457ced2067c"},{"name":"ui_theme","value":"light"}],"headers":[{"name":"Accept","value":"*/*"},{"name":"Accept-Encoding","value":"gzip, deflate, br, zstd"},{"name":"Accept-Language","value":"en-US,en;q=0.9"},{"name":"Connection","value":"keep-alive"},{"name":"Cookie","value":"sid=9db87b289c04b966a0184457ced2067c; ui_theme=light"},{"name":"Host","value":"localhost:4000"},{"name":"Referer","value":"http://localhost:4000/dashboard"},{"name":"Sec-Fetch-Dest","value":"empty"},{"name":"Sec-Fetch-Mode","value":"cors"},{"name":"Sec-Fetch-Site","value":"