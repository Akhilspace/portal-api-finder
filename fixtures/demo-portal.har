       "value": "light"
      }
     ]
    },
    "response": {
     "status": 200,
     "statusText": "OK",
     "headers": [
      {
       "name": "connection",
       "value": "keep-alive"
      },
      {
       "name": "content-length",
       "value": "2818"
      },
      {
       "name": "content-type",
       "value": "application/javascript; charset=utf-8"
      },
      {
       "name": "date",
       "value": "Mon, 16 Nov 2026 17:40:44 GMT"
      },
      {
       "name": "etag",
       "value": "W/\"b02-k0ltWLo5uwDpUhR+aZXhQ3B9KV8\""
      },
      {
       "name": "keep-alive",
       "value": "timeout=5"
      },
      {
       "name": "x-powered-by",
       "value": "Express"
      }
     ],
     "content": {
      "size": 2818,
      "mimeType": "application/javascript; charset=utf-8",
      "text": "\nconst csrf = document.querySelector('meta[name=\"csrf-token\"]').content;\nconst $ = (id) => document.getElementById(id);\nconst api = (url, opts = {}) => fetch(url, { ...opts, headers: { \"X-Requested-With\": \"XMLHttpRequest\", ...(opts.headers || {}) } }).then((r) => r.json());\nconst beacon = (event) => fetch(\"/api/telemetry\", { method: \"POST\", headers: { \"Content-Type\": \"application/json\" }, body: JSON.stringify({ event, ts: Date.now(), path: location.pathname }) });\nlet patient = null, slot = null, timer = null;\napi(\"/api/me\").then((me) => ($(\"who\").textContent = me.displayName));\napi(\"/api/providers\").then((d) => { $(\"provider\").innerHTML = d.providers.map((p) => '<option value=\"' + p.id + '\">' + p.name + \"</option>\").join(\"\"); loadSlots(); });\nsetInterval(() => api(\"/api/notifications/unread-count\").then((d) => ($(\"unread\").textContent = d.unread)), 3000);\n$(\"q\").addEventListener(\"input\", () => { clearTimeout(timer); timer = setTimeout(search, 250); });\nasync function search() {\n  const q = $(\"q\").value.trim(); if (q.length < 2) return;\n  const d = await api(\"/api/patients?query=\" + encodeURIComponent(q) + \"&limit=10\");\n  $(\"results\").innerHTML = d.results.map((p) => '<li data-id=\"' + p.id + '\">' + p.lastName + \", \" + p.firstName + \" (\" + p.mrn + \")</li>\").join(\"\") || \"<li>No match</li>\";\n}\n$(\"results\").addEventListener(\"click\", (e) => { const li = e.target.closest(\"li[data-id]\"); if (!li) return; patient = Number(li.dataset.id); $(\"picked\").textContent = li.textContent; $(\"charge\").innerHTML = ' <a href=\"/legacy/billing/new.php?pid=' + patient + '\">Add a billing charge (legacy module)</a>'; beacon(\"patient_selected\"); });\n$(\"provider\").addEventListener(\"change\", loadSlots); $(\"date\").addEventListener(\"change\", loadSlots);\nasync function loadSlots() {\n  const d = await api(\"/api/providers/\" + $(\"provider\").value + \"/slots?date=\" + $(\"date\").value);\n  $(\"slots\").innerHTML = d.slots.map((s) => '<button type=\"button\" data-slot=\"' + s.slotId + '\">' + s.start.slice(11, 16) + \"</button>\").join(\"\");\n}\n$(\"slots\").addEventListener(\"click\", (e) => { if (!e.target.dataset.slot) return; slot = e.target.dataset.slot; [...$(\"slots\").children].forEach((b) => b.classList.toggle(\"on\", b === e.target)); });\n$(\"book\").addEventListener(\"click\", async () => {\n  if (!patient || !slot) return ($(\"msg\").textContent = \"Pick a patient and a time first.\");\n  beacon(\"book_clicked\");\n  const d = await api(\"/api/appointments\", { method: \"POST\", headers: { \"Content-Type\": \"application/json\", \"X-CSRF-Token\": csrf },\n    body: JSON.stringify({ patientId: patient, providerId: Number($(\"provider\").value), slotId: slot, reason: $(\"reason\").value, visitType: \"office\", notifyPatient: true }) });\n  $(\"msg\").textContent = d.appointment ? \"Booked. Confirmation \" + d.appointment.id : \"Error: \" + d.error;\n});\n"
     },
     "redirectURL": ""
    }
   },
