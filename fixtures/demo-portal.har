   {
    "startedDateTime": "2026-11-16T15:00:07.611Z",
    "time": 35,
    "_resourceType": "script",
    "request": {
     "method": "GET",
     "url": "http://localhost:4000/static/app.js",
     "headers": [
      {
       "name": "Accept",
       "value": "*/*"
      },
      {
       "name": "User-Agent",
       "value": "Mozilla/5.0 (demo recorder)"
